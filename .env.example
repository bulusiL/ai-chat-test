# ===========================================
# AI Chat Assistant 环境变量配置模板
# ===========================================
# 复制此文件为 .env.local 并填入实际值
# cp .env.example .env.local

# ----------------
# Ollama 配置
# ----------------
# Ollama 服务地址（本地或远程）
OLLAMA_BASE_URL=http://localhost:11434

# 默认使用的模型名称
# 常用模型: qwen2.5:7b, llama3.1:8b, mistral:7b, deepseek-r1:7b
OLLAMA_MODEL=qwen2.5:7b

# ----------------
# 数据库配置 (必须配置)
# ----------------
# 数据库类型: mysql 或 postgresql
DB_TYPE=mysql

# MySQL 连接信息
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_chat
DB_USER=root
DB_PASSWORD=your_password

# ----------------
# 可选配置
# ----------------
# 服务端口（默认 5000）
PORT=5000

# 运行环境: DEV 或 PROD
COZE_PROJECT_ENV=DEV
