# ===========================================
# AI Chat Assistant 环境变量配置模板
# ===========================================
# 复制此文件为 .env.local 并填入实际值
# cp .env.example .env.local

# ----------------
# Ollama 配置（必须配置）
# ----------------
# Ollama 服务地址（本地或远程）
# 注意：不要带 /v1 后缀
OLLAMA_BASE_URL=http://localhost:11434

# 默认使用的模型名称
# 常用模型: qwen2.5:7b, llama3.1:8b, mistral:7b, deepseek-r1:7b
OLLAMA_MODEL=qwen2.5:7b

# ----------------
# 数据库配置（必须配置）
# ----------------
# 数据库类型: mysql 或 postgresql
DB_TYPE=mysql

# MySQL 连接信息
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ai_chat
DB_USER=root
DB_PASSWORD=your_password

# ----------------
# 联网搜索配置（可选）
# ----------------
# 系统默认使用免费的 Wikipedia 搜索，无需配置
# 如需更强大的搜索能力，可配置以下 API

# 1. Bing Search API（推荐）
# 免费额度：每月 1000 次搜索
# 申请地址：https://azure.microsoft.com/services/cognitive-services/bing-web-search-api/
# BING_API_KEY=your_bing_api_key

# 2. SerpAPI
# 免费额度：每月 100 次
# 申请地址：https://serpapi.com/
# SERPAPI_KEY=your_serpapi_key

# 3. Wikipedia（默认启用，完全免费）
# 无需配置，直接使用

# ----------------
# 其他配置
# ----------------
# 服务端口（默认 5000）
PORT=5000

# 运行环境: DEV 或 PROD
COZE_PROJECT_ENV=DEV
